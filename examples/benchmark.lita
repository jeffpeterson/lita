fn benchmark(fun, setup)
	let total = 0
	let i = 0

	while total < 0.5
		let data = setup()
		let start = clock()
		fun(data)
		total += clock() - start
		i++

	print("i: "i", total: "total"s, avg: "(i / total)"/s")

fn setup = (0..999).array

fn find_99(data) = data.find(.is?(99))

benchmark(find_99, setup)
