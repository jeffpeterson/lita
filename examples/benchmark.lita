fn benchmark(fun, setup)
	let total = 0
	let i = 0

	while total < 1
		let data = setup()
		let start = clock()
		fun(data)
		let end = clock()
		total += end - start
		i++

	print("i: " i ", total: " total)

fn setup = (0..999).array

fn find_99(data) = data.find(.is?(99))

benchmark(find_99, setup)
